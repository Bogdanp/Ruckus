#!/usr/bin/env bash

set -euo pipefail

HERE="$(basename "$(dirname "$0")")"
RUCKUS_DIR="$(realpath "${HERE}/../Ruckus")"
RACKET_DIR="${PBRACKET_ROOT}/racket"

rsync -ravz --exclude '.gitignore' "$RACKET_DIR/collects" "$RUCKUS_DIR/racket/"
rsync -ravz "$RACKET_DIR/doc" "$RUCKUS_DIR/racket/"
rsync -ravz "$RACKET_DIR/share" "$RUCKUS_DIR/racket/"
rm -rf "$RUCKUS_DIR/racket/share/pkgs/.trash"
rm -rf "$RUCKUS_DIR/racket/share/pkgs/"{*-doc,*-test}
rm -rf "$RUCKUS_DIR/racket/share/pkgs/"*-aarch64-*

# Remove packages outside the transitive dependency closure.
UNNEEDED=$(./bin/pbracket bin/compute-needed-pkgs.rkt main-distribution ruckus-openssl)
for pkg in $UNNEEDED; do
  rm -rf "$RUCKUS_DIR/racket/share/pkgs/$pkg"
done

racket "$HERE/clean-links.rkt" "$RUCKUS_DIR/racket/share/links.rktd"
find "$RUCKUS_DIR/racket/share" -name '*.c' -exec rm \{\} \;
